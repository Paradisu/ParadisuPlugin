# Copy to dev.local.toml (gitignored) to override dev.toml.

accept_eula = true
#online_mode = false  # let any username join (UUIDs will not match production)

# Pin the Minecraft DataVersion stamped on generated items (normally read from the downloaded server jar)
#data_version = 5023

# Address players are transferred to (Limbo and back); set it when others join from outside
#public_host = "192.168.1.20"

#[jvm]
#hotswap_agent = true

# Enable a second backend for cross-server testing
#[[servers]]
#name = "creative"
#enabled = true

# Add a plugin
#[[plugins]]
#key = "essentialsx"
#source = "modrinth"
#slug = "essentialsx"
#platforms = ["paper"]

# Use a jar you built yourself
#[[plugins]]
#key = "mything"
#source = "local"
#path = "dev/plugins-local/MyThing.jar"
#platforms = ["paper"]

# Serve the zellij console workspace to the network (HTTPS, self-signed); the default 127.0.0.1 is reached by port forwarding
#[web]
#bind = "0.0.0.0"

# Public tunnels (`dev share start`); a Pinggy Pro token gives a stable address and removes the 60-minute limit
#[share]
#targets = ["proxy", "limbo", "web"]
#[share.providers.pinggy]
#token = "..."
