{
    // Builds the Dockerfile locally (use when editing the Dockerfile or GHCR is unreachable). Keep in sync with ../devcontainer.json.
    "name": "Paradisu (build locally)",
    "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.local.yml"],
    // Runs on the host before the container is created, from the workspace folder. Layer caching makes repeats quick.
    "initializeCommand": "docker build -f .devcontainer/Dockerfile -t paradisuplugin-devcontainer:local .",
    "service": "dev",
    "workspaceFolder": "/workspaces/ParadisuPlugin",
    "shutdownAction": "stopCompose",
    "remoteUser": "vscode",
    "postCreateCommand": "dev bootstrap",
    // The proxy port (25565) is published by compose; backend and JDWP ports stay inside the container.
    // Codespaces / remote Docker hosts: forward 25565 manually.
    "otherPortsAttributes": { "onAutoForward": "ignore" },
    // zellij web client (`dev web start`): VS Code forwards it to the host with the default 127.0.0.1 bind
    "forwardPorts": [8082],
    "portsAttributes": { "8082": { "label": "zellij web", "onAutoForward": "silent" } },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-ossdata.vscode-pgsql",
                // Lombok support needs the pre-release channel of the Java and Gradle extensions
                "redhat.java@prerelease",
                "vscjava.vscode-java-test",
                "vscjava.vscode-java-debug",
                "vscjava.vscode-gradle@prerelease",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "misodee.vscode-nbt"
            ],
            "settings": {
                "java.jdt.ls.java.home": "/opt/jbr",
                "java.import.gradle.java.home": "/opt/jbr",
                "java.configuration.runtimes": [
                    { "name": "JavaSE-25", "path": "/opt/jbr", "default": true }
                ],
                "java.debug.settings.hotCodeReplace": "auto",
                "java.autobuild.enabled": true,
                // Keep Eclipse/Buildship metadata (.project, .classpath, .settings) out of the bind-mounted checkout: the host IDE
                // writes its own Java paths there, and the container would pick them up (and overwrite them for the host)
                "java.import.generatesMetadataFilesAtProjectRoot": false,
                "java.import.exclusions": [
                    "**/node_modules/**",
                    "**/.metadata/**",
                    "**/archetype-resources/**",
                    "**/META-INF/maven/**",
                    "**/dev/run/**",
                    "**/dev/.cache/**"
                ],
                "files.watcherExclude": { "**/dev/run/**": true, "**/dev/.cache/**": true },
                "search.exclude": { "**/dev/run": true, "**/dev/.cache": true }
            }
        }
    }
}
