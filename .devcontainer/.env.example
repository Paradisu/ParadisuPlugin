# Copy to .devcontainer/.env (gitignored).

# Tag of ghcr.io/paradisu/paradisuplugin-devcontainer to use (a branch name tests an image change before merge).
#PARADISU_DEVCONTAINER_TAG=latest

# Host port published for the Velocity proxy.
#PARADISU_PROXY_PORT=25565

# Host port published for Limbo. If you change it, also set limbo.public_port in dev/dev.local.toml.
#PARADISU_LIMBO_PORT=30000
