# Copy to .devcontainer/.env (gitignored).

# Tag of ghcr.io/paradisu/mcdevtools-devcontainer to use (a branch name tests an image change before merge).
#MCDEVTOOLS_DEVCONTAINER_TAG=latest

# Host port published for the Velocity proxy.
#MCDEV_PROXY_PORT=25565

# Host port published for Limbo. If you change it, also set the limbo instance's public_port in .mcdevtools/config.local.toml.
#MCDEV_LIMBO_PORT=30000
